---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site.js';
---

<Layout
  title="Contact Us"
  description="Contact Ware Therapeutic Massage & Acupuncture in Windermere, Edmonton. #203 – 6055 Andrews Way SW. Open 7 days a week, 9 AM–9 PM."
>
  <section class="bg-sage-100 border-b border-sage-200">
    <div class="mx-auto max-w-6xl px-4 py-16 md:py-20 text-center">
      <p class="text-sm font-semibold tracking-[0.25em] uppercase text-sage-600">Contact</p>
      <h1 class="mt-3 font-display text-4xl md:text-5xl text-sage-900">Visit or get in touch</h1>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 grid gap-10 lg:grid-cols-2">
    <div class="space-y-8">
      <div>
        <h2 class="font-display text-2xl text-sage-900">Location</h2>
        <p class="mt-3 text-lg text-ink/80">{site.address}</p>
        <p class="mt-1 text-ink/70">
          Second floor, Windermere — free parking on site.
        </p>
        <a
          href={site.mapsUrl}
          target="_blank"
          rel="noopener"
          class="mt-3 inline-block font-semibold text-sage-600 hover:text-sage-700"
        >
          Open in Google Maps →
        </a>
      </div>

      <div>
        <h2 class="font-display text-2xl text-sage-900">Hours</h2>
        <p class="mt-3 text-lg text-ink/80">{site.hours}</p>
      </div>

      <div>
        <h2 class="font-display text-2xl text-sage-900">Phone &amp; email</h2>
        <p class="mt-3 text-lg text-ink/80">
          <a href={`tel:${site.phones[0]}`} class="hover:text-sage-600">{site.phones[0]}</a>
          <span class="text-ink/40"> · </span>
          <a href={`tel:${site.phones[1]}`} class="hover:text-sage-600">{site.phones[1]}</a>
        </p>
        <p class="mt-1 text-lg">
          <a href={`mailto:${site.email}`} class="text-sage-600 hover:text-sage-700">{site.email}</a>
        </p>
      </div>

      <div>
        <a
          href={site.bookingUrl}
          target="_blank"
          rel="noopener"
          class="inline-block rounded-full bg-sage-600 px-8 py-3.5 font-semibold text-white shadow-sm hover:bg-sage-700 transition-colors"
        >
          Book Online
        </a>
      </div>
    </div>

    <div class="space-y-6">
      <div class="overflow-hidden rounded-2xl border border-sage-200 shadow-sm">
        <iframe
          src={site.mapsEmbedUrl}
          title="Map to Ware Therapeutic Massage & Acupuncture"
          class="w-full min-h-[20rem]"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        >
        </iframe>
      </div>
      <figure class="overflow-hidden rounded-2xl border border-sage-200 shadow-sm bg-white">
        <img
          src="/images/building-side.jpg"
          alt="Windermere Health & Business Centre building at 6055 Andrews Way SW, Edmonton — home of Ware Therapeutic Massage & Acupuncture"
          class="w-full object-cover"
          loading="lazy"
        />
        <figcaption class="px-5 py-4 text-sm text-ink/70">
          Look for the green leaf sign — we're on the second floor of the
          Windermere Health &amp; Business Centre.
        </figcaption>
      </figure>
    </div>
  </section>
</Layout>
