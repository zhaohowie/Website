---
import Layout from '../layouts/Layout.astro';
import { site, therapists } from '../data/site.js';
---

<Layout
  title="Our Team"
  description="Meet the registered massage therapists, acupuncturists and manual osteopathic therapists at Ware Therapeutic Massage & Acupuncture in Edmonton."
>
  <section class="bg-sage-100 border-b border-sage-200">
    <div class="mx-auto max-w-6xl px-4 py-16 md:py-20 text-center">
      <p class="text-sm font-semibold tracking-[0.25em] uppercase text-sage-600">Our team</p>
      <h1 class="mt-3 font-display text-4xl md:text-5xl text-sage-900">Meet your therapists</h1>
      <p class="mx-auto mt-5 max-w-2xl text-ink/80">
        Highly experienced, licensed and dedicated to their craft — our team of
        registered massage therapists and acupuncturists is here to help you feel
        your best.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="grid gap-6 md:grid-cols-2" data-stagger>
      {
        therapists.map((t) => (
          <article class="card-lift rounded-2xl border border-sage-200 bg-white p-8 shadow-sm">
            <div class="flex items-center gap-4">
              <span class="grid size-16 shrink-0 place-items-center rounded-full bg-sage-100 font-display text-2xl text-sage-700">
                {t.name.replace('Dr. ', '').charAt(0)}
              </span>
              <div>
                <h2 class="font-display text-2xl text-sage-900">{t.name}</h2>
                <p class="text-sm font-semibold text-sage-600">{t.credentials}</p>
              </div>
            </div>
            <p class="mt-5 leading-relaxed text-ink/80">{t.bio}</p>
            <div class="mt-5 flex flex-wrap gap-2">
              {t.specialties.map((s) => (
                <span class="rounded-full bg-sage-50 border border-sage-200 px-3 py-1 text-xs font-medium text-sage-700">
                  {s}
                </span>
              ))}
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-12 text-center">
      <a
        href={site.bookingUrl}
        target="_blank"
        rel="noopener"
        class="inline-block rounded-full bg-sage-600 px-8 py-3.5 font-semibold text-white shadow-sm hover:bg-sage-700 transition-colors"
      >
        Book with our team
      </a>
    </div>
  </section>
</Layout>
