---
import Layout from '../../layouts/Layout.astro';
import { site, services } from '../../data/site.js';
import { serviceContent } from '../../data/seo-content.js';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const content = serviceContent[service.slug];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.name,
  serviceType: service.name,
  description: content.metaDescription,
  areaServed: 'Edmonton, AB, Canada',
  provider: {
    '@type': 'HealthAndBeautyBusiness',
    name: site.name,
    telephone: site.phones[0],
    address: {
      '@type': 'PostalAddress',
      streetAddress: '#203 – 6055 Andrews Way SW',
      addressLocality: 'Edmonton',
      addressRegion: 'AB',
      postalCode: 'T6W 3S9',
      addressCountry: 'CA',
    },
  },
  offers: service.prices.map((p) => ({
    '@type': 'Offer',
    price: p.price,
    priceCurrency: 'CAD',
    description: p.duration,
  })),
};

const faqSchema =
  content.faqs && content.faqs.length
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: content.faqs.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;

const related = services
  .filter((s) => s.slug !== service.slug)
  .slice(0, 3);
---

<Layout title={content.metaTitle} description={content.metaDescription}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </Fragment>

  <section class="bg-sage-100 border-b border-sage-200">
    <div class="mx-auto max-w-6xl px-4 py-16 md:py-20">
      <nav class="text-sm text-sage-700">
        <a href="/" class="hover:text-sage-900">Home</a>
        <span class="mx-2 text-sage-400">/</span>
        <a href="/services/" class="hover:text-sage-900">Services &amp; Prices</a>
        <span class="mx-2 text-sage-400">/</span>
        <span class="text-sage-900">{service.name}</span>
      </nav>
      <h1 class="mt-6 font-display text-4xl md:text-5xl text-sage-900 text-balance">
        {service.name} <span class="block mt-2 text-2xl md:text-3xl text-sage-700">in Windermere, Edmonton</span>
      </h1>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href={site.bookingUrl}
          target="_blank"
          rel="noopener"
          class="rounded-full bg-sage-600 px-8 py-3.5 font-semibold text-white shadow-sm hover:bg-sage-700 transition-colors"
        >
          Book {service.name}
        </a>
        <a
          href={`tel:${site.phones[0]}`}
          class="rounded-full border border-sage-400 px-8 py-3.5 font-semibold text-sage-800 hover:bg-sage-200/60 transition-colors"
        >
          Call {site.phones[0]}
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 grid gap-12 lg:grid-cols-[1fr_22rem]">
    <div>
      {content.intro.map((p) => <p class="mt-5 first:mt-0 text-lg leading-relaxed text-ink/80">{p}</p>)}

      <h2 class="mt-10 font-display text-2xl text-sage-900">Benefits</h2>
      <ul class="mt-5 space-y-3 text-ink/80">
        {
          content.benefits.map((point) => (
            <li class="flex gap-3">
              <span class="mt-1 grid size-5 shrink-0 place-items-center rounded-full bg-sage-200 text-sage-700">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
              </span>
              {point}
            </li>
          ))
        }
      </ul>

      {
        content.faqs && content.faqs.length > 0 && (
          <>
            <h2 class="mt-12 font-display text-2xl text-sage-900">Frequently asked questions</h2>
            <div class="mt-5 space-y-4">
              {content.faqs.map((f) => (
                <details class="group rounded-2xl border border-sage-200 bg-white p-6 shadow-sm">
                  <summary class="cursor-pointer font-semibold text-sage-900 list-none flex justify-between items-center gap-4">
                    {f.q}
                    <span class="text-sage-500 transition-transform group-open:rotate-45 text-xl leading-none">+</span>
                  </summary>
                  <p class="mt-4 leading-relaxed text-ink/80">{f.a}</p>
                </details>
              ))}
            </div>
          </>
        )
      }
    </div>

    <aside class="space-y-6">
      <div class="rounded-2xl border border-sage-200 bg-white p-7 shadow-sm">
        <h2 class="font-display text-xl text-sage-900">Prices</h2>
        <table class="mt-4 w-full text-sm">
          <tbody>
            {
              service.prices.map((p) => (
                <tr class="border-t border-sage-100 first:border-t-0">
                  <td class="py-2.5 text-ink/80">{p.duration}</td>
                  <td class="py-2.5 text-right font-semibold text-sage-800">
                    {p.note === 'starting from' ? 'from ' : ''}${p.price}
                    {p.note && p.note !== 'starting from' ? (
                      <span class="ml-1 font-normal text-ink/60">({p.note})</span>
                    ) : null}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="mt-3 text-xs text-ink/60">Prices in CAD. GST applies. Direct billing to most insurers.</p>
        <a
          href={site.bookingUrl}
          target="_blank"
          rel="noopener"
          class="mt-5 block rounded-full bg-sage-600 px-6 py-3 text-center font-semibold text-white hover:bg-sage-700 transition-colors"
        >
          Book Now
        </a>
      </div>

      <div class="rounded-2xl bg-sage-50 border border-sage-200 p-7">
        <h2 class="font-display text-xl text-sage-900">Also popular</h2>
        <ul class="mt-4 space-y-3">
          {
            related.map((s) => (
              <li>
                <a href={`/services/${s.slug}/`} class="font-semibold text-sage-600 hover:text-sage-700">
                  {s.name} →
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="rounded-2xl bg-sage-700 p-7 text-cream text-sm">
        <p class="font-display text-lg">Visit us</p>
        <p class="mt-3 text-sage-100">{site.address}</p>
        <p class="mt-1 text-sage-100">{site.hours}</p>
        <p class="mt-1 text-sage-100">{site.phones[0]} · {site.phones[1]}</p>
      </div>
    </aside>
  </section>
</Layout>
