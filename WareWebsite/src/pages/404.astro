---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site.js';
---

<Layout title="Page Not Found" description="This page could not be found.">
  <section class="mx-auto max-w-3xl px-4 py-24 text-center">
    <p class="text-sm font-semibold tracking-[0.25em] uppercase text-sage-600">404</p>
    <h1 class="mt-3 font-display text-4xl md:text-5xl text-sage-900">
      This page seems to have wandered off
    </h1>
    <p class="mx-auto mt-5 max-w-xl text-ink/80">
      The page you're looking for doesn't exist or has moved. Try one of these
      instead:
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a href="/" class="rounded-full bg-sage-600 px-6 py-3 font-semibold text-white hover:bg-sage-700 transition-colors">Home</a>
      <a href="/services/" class="rounded-full border border-sage-400 px-6 py-3 font-semibold text-sage-800 hover:bg-sage-100 transition-colors">Services &amp; Prices</a>
      <a
        href={site.bookingUrl}
        target="_blank"
        rel="noopener"
        class="rounded-full border border-sage-400 px-6 py-3 font-semibold text-sage-800 hover:bg-sage-100 transition-colors"
      >
        Book an Appointment
      </a>
    </div>
  </section>
</Layout>
