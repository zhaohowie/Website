---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site.js';
import { generalFaqs } from '../data/seo-content.js';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: generalFaqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="FAQ — Direct Billing, Insurance & Visits"
  description="Answers about direct billing, insurance coverage, referrals, MVA claims, parking and what to expect at Ware Therapeutic Massage & Acupuncture in Edmonton."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <section class="bg-sage-100 border-b border-sage-200">
    <div class="mx-auto max-w-6xl px-4 py-16 md:py-20 text-center">
      <p class="text-sm font-semibold tracking-[0.25em] uppercase text-sage-600">FAQ</p>
      <h1 class="mt-3 font-display text-4xl md:text-5xl text-sage-900">Frequently asked questions</h1>
      <p class="mx-auto mt-5 max-w-2xl text-ink/80">
        Everything you need to know about insurance, billing and your first
        visit. Can't find your answer? <a href="/contact/" class="font-semibold text-sage-600 hover:text-sage-700">Contact us</a> —
        we're happy to help.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-16">
    <div class="space-y-4" data-stagger>
      {
        generalFaqs.map((f) => (
          <details class="group rounded-2xl border border-sage-200 bg-white p-6 shadow-sm">
            <summary class="cursor-pointer font-semibold text-sage-900 list-none flex justify-between items-center gap-4">
              {f.q}
              <span class="text-sage-500 transition-transform group-open:rotate-45 text-xl leading-none">+</span>
            </summary>
            <p class="mt-4 leading-relaxed text-ink/80">{f.a}</p>
          </details>
        ))
      }
    </div>

    <div class="mt-12 text-center">
      <a
        href={site.bookingUrl}
        target="_blank"
        rel="noopener"
        class="inline-block rounded-full bg-sage-600 px-8 py-3.5 font-semibold text-white shadow-sm hover:bg-sage-700 transition-colors"
      >
        Book an Appointment
      </a>
    </div>
  </section>
</Layout>
