---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmt = (d) =>
  d.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<Layout
  title="Blog — Massage & Wellness Tips"
  description="Massage therapy, acupuncture and wellness advice from the team at Ware Therapeutic Massage & Acupuncture in Windermere, Edmonton."
>
  <section class="bg-sage-100 border-b border-sage-200">
    <div class="mx-auto max-w-6xl px-4 py-16 md:py-20 text-center">
      <p class="text-sm font-semibold tracking-[0.25em] uppercase text-sage-600">Blog</p>
      <h1 class="mt-3 font-display text-4xl md:text-5xl text-sage-900">Massage &amp; wellness tips</h1>
      <p class="mx-auto mt-5 max-w-2xl text-ink/80">
        Practical advice from our therapists — on treatments, insurance, recovery
        and feeling your best.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-stagger>
      {
        posts.map((post) => (
          <a
            href={`/blog/${post.id}/`}
            class="group card-lift flex flex-col rounded-2xl border border-sage-200 bg-white p-7 shadow-sm hover:border-sage-300"
          >
            <p class="text-xs font-semibold tracking-wide uppercase text-sage-500">
              {fmt(post.data.pubDate)}
            </p>
            <h2 class="mt-3 font-display text-xl text-sage-900 group-hover:text-sage-600 transition-colors text-balance">
              {post.data.title}
            </h2>
            <p class="mt-3 text-sm leading-relaxed text-ink/70 flex-1">{post.data.description}</p>
            <p class="mt-5 text-sm font-semibold text-sage-600">Read article →</p>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
